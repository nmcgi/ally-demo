{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // For the build, resolve @ally/shared-types through node_modules to its
    // built .d.ts (the src path alias in tsconfig.json is for editor/type-check
    // only and would pull package source outside rootDir).
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}

NODE_ENV=development
PORT=3001

# Comma-separated browser origins allowed to call the API.
# Unset locally = the default localhost dev ports (3000, 3002, 3003, 3004).
CORS_ORIGINS=

# Postgres (local: matches docker-compose.yml)
DATABASE_URL=postgresql://ally:ally_local@localhost:5432/ally_db

# Override TypeORM query logging (defaults to on when NODE_ENV=development).
# `pnpm db:seed` sets this to false so its output stays readable.
DB_LOGGING=

# JWT
JWT_SECRET=change-me-local-dev-secret
JWT_REFRESH_SECRET=change-me-local-refresh-secret

# AWS (only needed for Step Functions integration)
AWS_REGION=us-east-1
STEP_FUNCTIONS_LOAN_ARN=
STEP_FUNCTIONS_KYC_ARN=
